{
  "name": "repopilot",
  "version": "0.3.0",
  "private": true,
  "description": "A local tool that scans your project folders and writes a JSON file for your website.",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "app": "electron .",
    "dist": "electron-builder",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
